---
/** Общий каркас всех страниц: <head> с SEO, шапка, контент, футер. */
import '@/styles/base.css';

import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import PaletteSwitcher from '@/components/layout/PaletteSwitcher.astro';
import { site } from '@/data/site';

interface Props {
  /** Заголовок вкладки. Имя бренда добавляется автоматически. */
  title?: string;
  description?: string;
  /** Прозрачная шапка поверх большого фото (главная). */
  overlayHeader?: boolean;
}

const { title, description = site.description, overlayHeader = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.brand}` : `${site.name} — ${site.role} в Бресте`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Метка «JS работает»: только тогда прячем блоки до анимации появления -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ru_RU" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@400;500&family=Great+Vibes&display=swap"
    />
  </head>
  <body>
    <Header overlay={overlayHeader} />
    <main>
      <slot />
    </main>
    <Footer />
    {import.meta.env.DEV && <PaletteSwitcher />}
    <script>
      import '@/scripts/reveal.ts';
    </script>
  </body>
</html>
