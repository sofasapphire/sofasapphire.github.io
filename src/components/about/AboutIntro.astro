---
/** Знакомство: портрет в форме арки (как сертификат) + «Привет, я Софа». Данные — data/pages/about/intro.json */
import { Image } from 'astro:assets';

import { intro, photos } from '@/data/pages/about';
---

<section class="bg-tint intro">
  <div class="container intro__inner">
    <div class="intro__photo" data-reveal>
      <Image
        src={photos.intro.image}
        alt={photos.intro.alt}
        widths={[400, 700, 1000]}
        sizes="(max-width: 860px) 90vw, 480px"
        loading="eager"
      />
    </div>
    <div class="intro__text" data-reveal>
      <p class="eyebrow">{intro.eyebrow}</p>
      <h1>{intro.title}</h1>
      {intro.signature && <p class="signature">{intro.signature}</p>}
      <p class="lead">{intro.text}</p>
    </div>
  </div>
</section>

<style>
  .intro {
    padding-block: clamp(24px, 4vw, 48px) var(--section-y);
  }
  .intro__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(40px, 7vw, 96px);
    align-items: center;
  }

  /* Арка — тот же мотив, что у подарочного сертификата */
  .intro__photo {
    position: relative;
    max-width: 480px;
  }
  .intro__photo::before {
    content: '';
    position: absolute;
    inset: 18px -18px -18px 18px;
    border: 1px solid var(--color-accent-soft);
    border-radius: 999px 999px 0 0;
  }
  .intro__photo :global(img) {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: 999px 999px 0 0;
  }

  .intro__text h1 {
    margin-bottom: 0.4em;
    font-size: clamp(2.6rem, 6vw, 4.6rem);
  }
  .signature {
    margin-bottom: 1em;
  }

  @media (max-width: 860px) {
    .intro__inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .intro__photo {
      width: min(80%, 380px);
      margin-inline: auto;
    }
    .lead {
      margin-inline: auto;
    }
  }
</style>
