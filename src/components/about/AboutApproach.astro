---
/** «Как я снимаю»: принципы карточками. Данные — data/pages/about/approach.json (любое количество). */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { approach } from '@/data/pages/about';
---

<section class="section bg-beige">
  <div class="container">
    <SectionHeading eyebrow={approach.eyebrow} title={approach.title} />
    <ol class="cards">
      {
        approach.items.map((item, i) => (
          <li class="card" data-reveal>
            <span class="card__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    padding: clamp(28px, 4vw, 44px);
    border-top: 3px solid var(--color-accent);
    background: var(--color-bg);
  }
  .card__num {
    display: block;
    margin-bottom: 12px;
    font-family: var(--font-heading);
    font-size: 2.4rem;
    font-style: italic;
    line-height: 1;
    color: var(--color-accent-soft);
  }
  .card h3 {
    margin-bottom: 0.5em;
  }
  .card p {
    margin: 0;
  }
</style>
