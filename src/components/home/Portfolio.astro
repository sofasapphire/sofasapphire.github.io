---
/**
 * Виды съёмки на главной. Работает с любым их количеством:
 * первый вид — широкая плитка, остальные — по 3 в ряд (на телефоне по 2),
 * неполный последний ряд выравнивается по центру.
 */
import CategoryCard from '@/components/portfolio/CategoryCard.astro';
import Button from '@/components/ui/Button.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { categories } from '@/data/categories';
import { getShoots } from '@/lib/shoots';

const items = await Promise.all(
  categories.map(async (category) => {
    const [latest] = await getShoots(category.slug);
    const cover = latest && { image: latest.data.cover, alt: latest.data.coverAlt };
    return { category, cover };
  }),
);
const [featured, ...rest] = items;
---

<section class="section container" id="portfolio">
  <SectionHeading eyebrow="портфолио" title="Что я снимаю" />

  {featured && <CategoryCard {...featured} featured />}

  {
    rest.length > 0 && (
      <ul class="grid">
        {rest.map((item) => (
          <li>
            <CategoryCard {...item} />
          </li>
        ))}
      </ul>
    )
  }

  <div class="more" data-reveal>
    <Button href="/portfolio/" variant="ghost">Все съёмки</Button>
  </div>
</section>

<style>
  .more {
    margin-top: clamp(40px, 6vw, 64px);
    text-align: center;
  }
  .grid {
    --cols: 3;
    --gap: 24px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: calc(var(--gap) * 1.5) var(--gap);
    margin: var(--gap) 0 0;
    padding: 0;
    list-style: none;
  }
  .grid > li {
    flex: 0 0 calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols));
  }

  @media (max-width: 860px) {
    .grid {
      --cols: 2;
      --gap: 16px;
    }
  }
  @media (max-width: 520px) {
    .grid {
      --gap: 12px;
    }
  }
</style>
