---
/** «Обо мне» на бежевом фоне; у фото — лавандовая рамка со смещением. Тексты — data/pages/home/about.json */
import { Image } from 'astro:assets';

import { about, aboutPhoto } from '@/data/pages/home';
---

<section class="section bg-beige">
  <div class="container about">
    <div class="about__frame" data-reveal>
      <Image
        class="about__photo"
        src={aboutPhoto.image}
        alt={aboutPhoto.alt}
        widths={[400, 600, 900]}
        sizes="(max-width: 860px) 100vw, 45vw"
      />
    </div>
    <div data-reveal>
      <p class="eyebrow">{about.eyebrow}</p>
      <h2>{about.title}<br /><em>{about.titleAccent}</em></h2>
      <p>{about.text}</p>
      <a class="link" href="/obo-mne/">{about.linkText}</a>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }
  .about__frame {
    position: relative;
    margin: 0 18px 18px 0;
  }
  .about__frame::before {
    content: '';
    position: absolute;
    inset: 18px -18px -18px 18px;
    background: var(--color-accent-soft);
  }
  .about :global(.about__photo) {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: 50% 30%;
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }
    .about__frame {
      max-width: 420px;
      margin-inline: auto;
    }
  }
</style>
