---
/**
 * Галерея съёмки — «плетёная витрина» (masonry), как на nadia-vaisse.com:
 * две колонки на любом экране, фото в своих пропорциях, края кадров в соседних колонках
 * не совпадают, а верх и низ колонок — на одной линии. Раскладка — src/lib/masonry.ts.
 *
 * По нажатию фото открывается на весь экран (PhotoSwipe): листание стрелками и свайпом,
 * увеличение пальцами. Листается в исходном порядке фото, а не по колонкам.
 * Без JavaScript ссылка просто открывает большое фото.
 */
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';

import { layoutMasonry } from '@/lib/masonry';

interface Props {
  photos: ImageMetadata[];
  alt: string;
}

/** Ширина большой версии для полноэкранного просмотра. */
const FULL_WIDTH = 2000;

const { photos, alt } = Astro.props;

const full = await Promise.all(
  photos.map((photo) =>
    getImage({ src: photo, width: Math.min(FULL_WIDTH, photo.width), format: 'webp' }),
  ),
);

const columns = layoutMasonry(photos.map((p) => p.height / p.width))
  .filter((col) => col.length > 0)
  .map((col) =>
    col.map((cell) => ({
      ...cell,
      photo: photos[cell.index],
      full: full[cell.index],
      alt: `${alt} — фото ${cell.index + 1}`,
    })),
  );
---

<div class:list={['masonry', { 'masonry--single': columns.length === 1 }]} data-gallery>
  {
    columns.map((items) => (
      <div class="masonry__col">
        {items.map(({ photo, full, index, ratio, cropped, alt }) => (
          <a
            class="masonry__item"
            href={full.src}
            data-index={index}
            data-width={full.attributes.width}
            data-height={full.attributes.height}
            data-reveal="fade"
          >
            <Image
              src={photo}
              {alt}
              widths={[400, 600, 900, 1300]}
              sizes="(max-width: 1400px) 50vw, 680px"
              loading={index < 4 ? 'eager' : 'lazy'}
              class:list={{ cropped }}
              style={`--ratio: ${(1 / ratio).toFixed(4)}`}
            />
          </a>
        ))}
      </div>
    ))
  }
</div>

<script>
  import '@/scripts/gallery-lightbox.ts';
</script>

<style>
  .masonry {
    --gap: 14px;
    display: flex;
    gap: var(--gap);
  }
  .masonry__col {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }
  .masonry__item {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    cursor: zoom-in;
  }
  .masonry :global(img) {
    width: 100%;
    height: auto;
    transition: transform 0.6s var(--ease-soft);
  }
  .masonry__item:hover :global(img) {
    transform: scale(1.02);
  }
  .masonry :global(img.cropped) {
    aspect-ratio: var(--ratio);
    object-fit: cover;
    object-position: 50% 35%;
  }
  /* Последний кадр колонки добирает оставшиеся пиксели — низ колонок совпадает точно */
  .masonry__item:last-child {
    flex-grow: 1;
  }
  .masonry__item:last-child :global(img) {
    flex-grow: 1;
    min-height: 0;
    object-fit: cover;
    object-position: 50% 35%;
  }

  /* Мало фото — одна колонка по центру */
  .masonry--single .masonry__col {
    max-width: 700px;
    margin-inline: auto;
  }

  /* Телефон — те же две колонки, только мельче */
  @media (max-width: 700px) {
    .masonry {
      --gap: 6px;
    }
  }

  /* Фон полноэкранного просмотра — из палитры */
  :global(.pswp) {
    --pswp-bg: color-mix(in srgb, var(--color-dark) 35%, black);
  }
</style>
