---
/**
 * Плитка вида съёмки. Обложка — из последней съёмки этого вида, иначе заглушка.
 * featured — широкая плитка с подписью поверх фото (первый вид на главной).
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

import PhotoPlaceholder from '@/components/ui/PhotoPlaceholder.astro';
import type { Category } from '@/data/categories';

interface Props {
  category: Category;
  cover?: { image: ImageMetadata; alt: string };
  featured?: boolean;
}

const { category, cover, featured = false } = Astro.props;
---

<a class:list={['card', { 'card--featured': featured }]} href={`/${category.slug}/`} data-reveal>
  <div class="card__media">
    {
      cover ? (
        <Image
          src={cover.image}
          alt={cover.alt}
          widths={featured ? [600, 1000, 1600, 2200] : [300, 500, 800]}
          sizes={featured ? '(max-width: 1200px) 100vw, 1200px' : '(max-width: 860px) 50vw, 380px'}
        />
      ) : (
        <PhotoPlaceholder label="обложка" />
      )
    }
  </div>
  <div class="card__text">
    <h3>{category.title}</h3>
    <p>{category.short}</p>
  </div>
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
  }
  .card__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .card__media > :global(*) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    transition: transform 0.6s;
  }
  .card:hover .card__media > :global(*) {
    transform: scale(1.03);
  }

  .card__text h3 {
    margin: 16px 0 0.2em;
    transition: color 0.25s;
  }
  .card:hover .card__text h3 {
    color: var(--color-accent);
  }
  .card__text p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-muted);
  }

  /* Широкая плитка: фото во всю ширину, подпись поверх */
  .card--featured {
    position: relative;
    color: #fff;
  }
  .card--featured .card__media {
    aspect-ratio: 21 / 9;
  }
  .card--featured::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgb(0 0 0 / 55%), transparent 55%);
  }
  .card--featured .card__text {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    padding: clamp(20px, 4vw, 48px);
  }
  .card--featured .card__text h3 {
    font-size: clamp(1.8rem, 4vw, 3.2rem);
  }
  .card--featured:hover .card__text h3 {
    color: #fff;
  }
  .card--featured .card__text p {
    max-width: 520px;
    color: rgb(255 255 255 / 85%);
  }

  @media (max-width: 860px) {
    .card--featured .card__media {
      aspect-ratio: 4 / 3;
    }
  }
  @media (max-width: 520px) {
    .card__text h3 {
      margin-top: 10px;
      font-size: 1.15rem;
      letter-spacing: 0.03em;
    }
    .card__text p {
      font-size: 0.8rem;
      line-height: 1.5;
    }
    .card--featured .card__media {
      aspect-ratio: 4 / 5;
    }
    .card--featured .card__text h3 {
      font-size: 1.8rem;
    }
  }
</style>
