---
/**
 * Частые вопросы — раскрывающиеся пункты (<details>, работает без JavaScript).
 * Данные — data/pages/prices/faq.json (любое количество).
 */
import Fill from '@/components/ui/Fill.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { faq } from '@/data/pages/prices';
---

<section class="section bg-beige">
  <div class="container">
    <SectionHeading eyebrow={faq.eyebrow} title={faq.title} />
    <div class="faq">
      {
        faq.items.map((item) => (
          <details class="faq__item" data-reveal>
            <summary>{item.question}</summary>
            <p>
              <Fill text={item.answer} />
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    max-width: 820px;
    margin: 0 auto;
  }
  .faq__item {
    border-bottom: 1px solid var(--color-line);
  }
  summary {
    position: relative;
    padding: 22px 48px 22px 0;
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    letter-spacing: 0;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* Плюс, который превращается в минус */
  summary::before,
  summary::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 8px;
    width: 16px;
    height: 1.5px;
    background: var(--color-accent);
    transition: transform 0.3s var(--ease-soft);
  }
  summary::after {
    transform: rotate(90deg);
  }
  .faq__item[open] summary::after {
    transform: rotate(0deg);
  }
  summary:hover {
    color: var(--color-accent);
  }
  .faq__item p {
    margin: 0;
    padding: 0 48px 24px 0;
    color: var(--color-muted);
  }
</style>
