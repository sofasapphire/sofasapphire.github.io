---
/**
 * Карточки цен по видам съёмки. Данные — data/pages/prices/packages.json (любое количество).
 * featured — выделенная тёмная карточка; category — ссылка на примеры съёмок этого вида.
 */
import Fill from '@/components/ui/Fill.astro';
import { getCategory } from '@/data/categories';
import { packages } from '@/data/pages/prices';

// Колонки на компьютере: 4 карточки — сеткой 2×2, иначе по 3 (1–2 — сколько есть)
const count = packages.items.length;
const columns = count === 4 ? 2 : Math.min(count, 3);
---

<ul class="packages" style={`--cols: ${columns}`}>
  {
    packages.items.map((p) => {
      const category = p.category ? getCategory(p.category) : undefined;
      return (
        <li class:list={['package', { 'package--featured': p.featured }]} data-reveal>
          {p.featured && <span class="package__badge">популярное</span>}
          <h3>{p.title}</h3>
          <p class="package__price">
            <Fill text={p.price} />
          </p>
          {p.duration && (
            <p class="package__duration">
              <Fill text={p.duration} />
            </p>
          )}
          <ul class="package__includes">
            {p.includes.map((item) => (
              <li>
                <Fill text={item} />
              </li>
            ))}
          </ul>
          {category && (
            <a class="link package__link" href={`/${category.slug}/`}>
              Смотреть съёмки →
            </a>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  /* Колонки — из --cols (см. выше; планшет — 2, телефон — 1); неполный последний ряд — по центру */
  .packages {
    --gap: 24px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: calc(var(--gap) * 1.4) var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .package {
    flex: 0 0 calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols));
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(28px, 3.5vw, 40px);
    border: 1px solid var(--color-line);
    background: var(--color-bg);
  }
  .package--featured {
    border-color: var(--color-dark);
    background: var(--color-dark);
    color: var(--color-on-dark);
  }
  .package__badge {
    position: absolute;
    top: -12px;
    left: clamp(28px, 3.5vw, 40px);
    padding: 4px 12px;
    background: var(--color-accent-soft);
    color: var(--color-dark);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  h3 {
    margin-bottom: 0.6em;
  }
  .package__price {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3vw, 2.6rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: 0;
    color: var(--color-accent);
  }
  .package--featured .package__price {
    color: var(--color-accent-soft);
  }
  .package__duration {
    margin: 4px 0 0;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .package--featured .package__duration {
    color: rgb(255 255 255 / 70%);
  }
  .package__includes {
    flex: 1;
    margin: 24px 0;
    padding: 20px 0 0;
    border-top: 1px solid var(--color-line);
    list-style: none;
  }
  .package--featured .package__includes {
    border-color: rgb(255 255 255 / 15%);
  }
  .package__includes li {
    position: relative;
    padding-left: 20px;
    margin-bottom: 8px;
    font-size: 0.92rem;
  }
  /* Ромбик — как в «Живо · Тепло · Честно» */
  .package__includes li::before {
    content: '';
    position: absolute;
    top: 0.65em;
    left: 2px;
    width: 6px;
    height: 6px;
    background: var(--color-accent-soft);
    transform: rotate(45deg);
  }
  .package__link {
    align-self: flex-start;
    font-size: 0.85rem;
  }
  .package--featured .package__link {
    color: var(--color-accent-soft);
  }

  @media (max-width: 960px) {
    .packages {
      --cols: 2 !important;
    }
  }
  @media (max-width: 600px) {
    .packages {
      --cols: 1 !important;
    }
  }
</style>
